<!DOCTYPE html>
<html>
<head>
    <title>Join Club</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>
<body>

<div class="auth-box">

    <h1>
        Join The Club
    </h1>

    <form
        action="/join-club"
        method="POST"
    >
            <input
            type="password"
            name="passcode"
            placeholder="Enter Club Passcode"
            required
        >

        <button type="submit">
            Join Club
        </button>

    </form>

</div>

</body>
</html>