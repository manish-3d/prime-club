<!DOCTYPE html>
<html>
<head>
    <title>Become Admin</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>
<body>

<div class="auth-box">

    <h1>
        Admin Access
    </h1>

    <form
        action="/become-admin"
        method="POST"
    >
            <input
            type="password"
            name="passcode"
            placeholder="Enter Admin Passcode"
            required
        >

        <button type="submit">
            Become Admin
        </button>

    </form>

</div>

</body>
</html>