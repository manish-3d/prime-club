<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>
<body>

<div class="auth-box">

    <h1>
        Login
    </h1>

    <form action="/login" method="POST">

        <input
            type="email"
            name="username"
            placeholder="Email"
               required
        >

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

</div>

</body>
</html>