<!DOCTYPE html>
<html>
<head>
    <title>Members Only</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >
</head>
<body>

    <div class="navbar">

        <h1>
            Members Only
        </h1>

        <div class="nav-links">

            <% if (user) { %>
                 <a href="/new-message">
                    New Message
                </a>

                <a href="/join-club">
                    Join Club
                </a>

                <a href="/become-admin">
                    Become Admin
                </a>

                <a href="/logout">
                    Logout
                </a>

            <% } else { %>

                <a href="/login">
                    Login
                </a>

                <a href="/sign-up">
                    Sign Up
                       </a>

            <% } %>

        </div>

    </div>


    <div class="container">

        <% if (user) { %>

            <div class="card">

                <h2>
                    Welcome,
                    <%= user.first_name %>
                </h2>

                <% if (user.membership_status) { %>

                    <p class="status">
                        Club Member ✅
                    </p>
                     <% } %>

                <% if (user.is_admin) { %>

                    <p class="status">
                        Admin Access ✅
                    </p>

                <% } %>

            </div>

        <% } %>


        <h2 style="margin-top: 30px;">
            Latest Messages
        </h2>


        <% if (messages.length === 0) { %>
             <p class="empty">
                No messages yet.
            </p>

        <% } %>


        <% messages.forEach(message => { %>

            <div class="message-card">

                <h3>
                    <%= message.title %>
                </h3>

                <p>
                    <%= message.message_text %>
                </p>


                <% if (
                    user &&
                    user.membership_status
                      ) { %>

                    <div class="meta">

                        <p>
                            By:
                            <%= message.first_name %>
                            <%= message.last_name %>
                        </p>

                        <p>
                            <%= message.created_at %>
                        </p>

                    </div>

                <% } %>


                <% if (
                    user &&
                    user.is_admin
                ) { %>

                    <form
                     action="/message/<%= message.id %>/delete"
                        method="POST"
                    >

                        <button
                            class="delete-btn"
                            type="submit"
                        >
                            Delete Message
                        </button>

                    </form>

                <% } %>

            </div>

        <% }) %>

    </div>

</body>
</html>